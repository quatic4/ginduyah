# Public browser credentials only. Never put a service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Existing generator/channel statistics integration:
YOUTUBE_API_KEY=

# Server-only: requires approved Reddit Data API access. Never use NEXT_PUBLIC_.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=
# Optional, when your approved app uses an authorized read-scope refresh token:
REDDIT_REFRESH_TOKEN=
